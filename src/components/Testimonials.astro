---
import { testimonials } from '../data/site';
---

<section class="section">
  <div class="container">
    <div class="head" data-reveal>
      <p class="eyebrow">Kind words</p>
      <h2 class="h2">What our clients <em>say</em></h2>
    </div>
    <ul role="list" class="quotes">
      {
        testimonials.map((t, i) => (
          <li data-reveal style={`--reveal-delay: ${i * 0.1}s`}>
            <figure>
              <span class="mark" aria-hidden="true">“</span>
              <blockquote>
                <p>{t.quote}</p>
              </blockquote>
              <figcaption>{t.name}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .head {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(32px, 4vw, 56px);
  }

  .quotes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  figure {
    display: grid;
    align-content: start;
    gap: 1rem;
    height: 100%;
    margin: 0;
    padding: clamp(24px, 3vw, 36px);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .mark {
    font-family: var(--serif);
    font-size: 4rem;
    line-height: 0.6;
    height: 1.6rem;
    color: var(--fig);
  }

  blockquote {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.4rem;
    line-height: 1.3;
  }

  figcaption {
    margin-top: auto;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 859px) {
    .quotes {
      grid-template-columns: 1fr;
    }
  }
</style>
