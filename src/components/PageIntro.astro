---
/** Interior page header: eyebrow, headline (slot) and a lead paragraph. */
interface Props {
  eyebrow: string;
  lead?: string;
  align?: 'left' | 'center';
}

const { eyebrow, lead, align = 'left' } = Astro.props;
---

<section class:list={['intro', `intro--${align}`]}>
  <div class="container">
    <div class="inner" data-reveal>
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="h1"><slot /></h1>
      {lead && <p class="lead">{lead}</p>}
      <slot name="after" />
    </div>
  </div>
</section>

<style>
  .intro {
    padding-block: clamp(56px, 8vw, 112px) clamp(40px, 5vw, 72px);
  }

  .inner {
    display: grid;
    gap: 1.4rem;
    max-width: 820px;
  }

  .intro--center .inner {
    margin-inline: auto;
    text-align: center;
    justify-items: center;
  }

  .lead {
    max-width: 640px;
  }
</style>
