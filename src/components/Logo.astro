---
interface Props {
  tone?: 'ink' | 'paper';
  class?: string;
}

const { tone = 'ink', class: className } = Astro.props;
---

<a href="/" class:list={['logo', `logo--${tone}`, className]}>
  <span class="word">Nazari</span>{' '}<span class="rule" aria-hidden="true"></span><span class="sub">Events</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--ink);
    text-decoration: none;
    line-height: 1;
  }

  .logo--paper {
    color: var(--paper);
  }

  .word {
    font-family: var(--serif);
    font-size: 1.85rem;
    letter-spacing: -0.01em;
    transform: translateY(-1px);
  }

  .rule {
    width: 1px;
    height: 1.25rem;
    background: currentColor;
    opacity: 0.35;
  }

  .sub {
    font-family: var(--sans);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.34em;
    text-transform: uppercase;
  }
</style>
