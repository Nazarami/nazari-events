---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Photo from '../components/Photo.astro';
import Awards from '../components/Awards.astro';
import CtaBand from '../components/CtaBand.astro';
import { photos } from '../data/photos';
import { clients, site } from '../data/site';

const values = [
  {
    title: 'Made fresh',
    text: 'Every board is cut by hand from premium produce and prepared as close to your event as possible.',
  },
  {
    title: 'Finished on site',
    text: 'We deliver, unwrap and set up at your venue, adding the final garnishes in place. It’s why we don’t offer pickup.',
  },
  {
    title: 'Styled to you',
    text: 'Your colours, florals and theme shape the table, from the fruit we choose to the draping underneath it.',
  },
  {
    title: 'Done properly',
    text: 'We’re a registered, council-approved food business, with halal-friendly menus and options for dietary needs.',
  },
];
---

<Base
  title="About"
  description="Nazari Events, formerly Nazari Desserts, creates hand-cut fruit, grazing, dessert and mocktail tables for celebrations across Adelaide."
>
  <PageIntro eyebrow="About us" lead={`${site.name}, formerly ${site.formerName}, creates fruit, grazing and dessert tables for celebrations across Adelaide.`}>
    Edible art, made for <em>celebrations</em>
  </PageIntro>

  <section class="story">
    <div class="container story-grid">
      <div class="story-art" data-reveal>
        <Photo photo={photos.heroFruitBoardTier} ratio="4 / 5" shape="arch" frame sizes="(min-width: 960px) 460px, 86vw" position="60% 50%" />
      </div>
      <div class="story-copy" data-reveal style="--reveal-delay: 0.1s">
        <p class="eyebrow">Our story</p>
        <h2 class="h2">It started with <em>one fruit platter</em></h2>
        <p class="lead">
          Nazari Events began as Nazari Desserts, making fruit platters for family birthdays and get-togethers around Adelaide.
          Guests kept asking who made them, and one board led to the next.
        </p>
        <p>
          Today we create fruit, grazing, dessert and mocktail tables for weddings, Nikahs, showers, milestone birthdays and corporate
          events across South Australia, and we style the whole table around them.
        </p>
        <p>
          The name has changed, but the approach hasn’t. Everything is cut by hand, prepared as close to your event as possible and
          finished on site, so it looks its best the moment your guests arrive.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-tint" aria-labelledby="values-title">
    <div class="container">
      <div class="head" data-reveal>
        <p class="eyebrow">How we work</p>
        <h2 class="h2" id="values-title">What you can <em>count on</em></h2>
      </div>
      <ul role="list" class="values">
        {
          values.map((v, i) => (
            <li data-reveal style={`--reveal-delay: ${i * 0.08}s`}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="h3">{v.title}</h3>
              <p>{v.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="recognition-title">
    <div class="container recog">
      <div data-reveal>
        <p class="eyebrow">Recognition</p>
        <h2 class="h2" id="recognition-title">Proud to be <em>recognised</em></h2>
        <p class="lead">
          Being named a finalist alongside so many talented South Australian businesses means a great deal, and it’s thanks to every
          client who has trusted us with their celebration.
        </p>
        <Awards class="recog-awards" />
      </div>
      <div class="recog-side" data-reveal style="--reveal-delay: 0.1s">
        <Photo photo={photos.universityAwardsBoard} ratio="4 / 3" sizes="(min-width: 960px) 480px, 92vw" />
        <h3 class="list-title">Clients include</h3>
        <ul role="list" class="client-list">{clients.map((c) => <li>{c}</li>)}</ul>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .story {
    padding-bottom: var(--section);
  }

  .story-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(40px, 7vw, 112px);
    align-items: center;
  }

  .story-art {
    max-width: 460px;
    padding: 14px 0 0 14px;
  }

  .story-copy {
    display: grid;
    gap: 1.2rem;
  }

  .story-copy p:not(.eyebrow):not(.lead) {
    color: var(--ink-soft);
  }

  @media (max-width: 859px) {
    .story-grid {
      grid-template-columns: 1fr;
    }

    .story-art {
      max-width: 400px;
    }
  }

  .head {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(36px, 5vw, 56px);
  }

  .values {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(20px, 3vw, 40px);
  }

  .values li {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--ink);
  }

  .values .num {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--fig);
  }

  .values p {
    color: var(--ink-soft);
    font-size: 0.97rem;
  }

  @media (max-width: 959px) {
    .values {
      grid-template-columns: 1fr 1fr;
      row-gap: 40px;
    }
  }

  @media (max-width: 539px) {
    .values {
      grid-template-columns: 1fr;
    }
  }

  .recog {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(40px, 7vw, 112px);
    align-items: start;
  }

  .recog > div:first-child {
    display: grid;
    gap: 1.2rem;
  }

  .recog :global(.recog-awards) {
    margin-top: 0.6rem;
    flex-direction: column;
  }

  .recog-side {
    display: grid;
    gap: 1.2rem;
  }

  .list-title {
    margin-top: 0.8rem;
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .client-list {
    display: grid;
    gap: 0.4rem;
    font-family: var(--serif);
    font-size: 1.3rem;
    line-height: 1.3;
  }

  @media (max-width: 859px) {
    .recog {
      grid-template-columns: 1fr;
    }
  }
</style>
