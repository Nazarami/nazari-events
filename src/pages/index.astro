---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Awards from '../components/Awards.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBand from '../components/CtaBand.astro';
import { photos } from '../data/photos';
import { clients, occasions, services, steps, trustPoints, venues } from '../data/site';

const servicePhotos = {
  fruit: photos.fruitBoardClassic,
  grazing: photos.grazingCheeseRoses,
  desserts: photos.cheesecakeCups,
  drinks: photos.mocktailsFlorals,
  styling: photos.dessertTablePink,
};

const teaser = [
  photos.babyShowerPinkYellow,
  photos.nikahGrazing,
  photos.fruitAndDessertCups,
  photos.babyGirlSetup,
  photos.grazingElevated,
  photos.grazingCloseup,
];
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow" data-reveal><span>Grazing & event styling<span class="hide-sm"> · Adelaide</span></span></p>
        <h1 class="display" data-reveal style="--reveal-delay: 0.05s">
          The table everyone <em>gathers around.</em>
        </h1>
        <p class="lead" data-reveal style="--reveal-delay: 0.1s">
          Hand-cut fruit boards, grazing, dessert and mocktail tables, styled and set up at your venue. For weddings, Nikahs,
          showers, milestones and launches across South Australia.
        </p>
        <div class="hero-actions" data-reveal style="--reveal-delay: 0.15s">
          <a class="btn" href="/enquire">Request a quote <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn-outline" href="/gallery">See our work</a>
        </div>
        <ul role="list" class="trust" data-reveal style="--reveal-delay: 0.2s">
          {trustPoints.map((t) => <li>{t}</li>)}
        </ul>
      </div>

      <div class="hero-art" data-reveal style="--reveal-delay: 0.1s">
        <Photo
          class="hero-main"
          photo={photos.fruitBoardMarble}
          ratio="4 / 5"
          shape="arch"
          frame
          loading="eager"
          sizes="(min-width: 1200px) 520px, (min-width: 860px) 44vw, 86vw"
        />
        <Photo
          class="hero-small"
          photo={photos.babyShowerPinkYellow}
          ratio="1 / 1"
          loading="eager"
          sizes="(min-width: 860px) 220px, 40vw"
        />
        <div class="hero-badge">
          <span class="badge-kicker">Finalist</span>
          <span class="badge-title">Wedding Industry Awards</span>
          <span class="badge-detail">South Australia 2026</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section section-tint" id="services">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow">What we create</p>
          <h2 class="h2">Everything for the table, <em>styled as one.</em></h2>
        </div>
        <p class="lead">
          Book a single board or the whole setup. Every piece is made fresh, delivered and finished by us at your venue.
        </p>
      </div>

      <ul role="list" class="services">
        {
          services.map((s, i) => (
            <li class:list={['service', `service--${i < 3 ? 'tall' : 'wide'}`]} data-reveal style={`--reveal-delay: ${(i % 3) * 0.08}s`}>
              <a href={`/services#${s.id}`}>
                <Photo
                  photo={servicePhotos[s.id]}
                  ratio={i < 3 ? '4 / 5' : '3 / 2'}
                  sizes={i < 3 ? '(min-width: 960px) 380px, (min-width: 600px) 46vw, 92vw' : '(min-width: 960px) 580px, 92vw'}
                />
                <span class="service-text">
                  <span class="service-name">{s.name}</span>
                  <span class="service-short">{s.short}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Signature board -->
  <section class="section signature">
    <div class="container signature-grid">
      <div class="signature-art" data-reveal>
        <Photo
          photo={photos.halfHalfBoardMarble}
          ratio="4 / 5"
          frame
          sizes="(min-width: 960px) 520px, 92vw"
        />
      </div>
      <div class="signature-copy" data-reveal style="--reveal-delay: 0.1s">
        <p class="eyebrow">Our signature</p>
        <h2 class="h1">The 1.4m <em>Signature Long Board</em></h2>
        <p class="lead">
          Our longest board, and the one guests photograph first. Fruit, cheese or half and half, built on site with a carved fruit
          tier as its crown.
        </p>
        <dl class="specs">
          <div><dt>Length</dt><dd>1.4 metres</dd></div>
          <div><dt>Style</dt><dd>Fruit, cheese, or Half & Half</dd></div>
          <div><dt>Centrepiece</dt><dd>Carved fruit tier</dd></div>
          <div><dt>Finish</dt><dd>Built and garnished at your venue</dd></div>
        </dl>
        <a class="link-arrow" href="/enquire?interest=signature-board">Ask about the Signature Board <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- Occasions -->
  <section class="section section-tint">
    <div class="container occasions-grid">
      <div class="occasions-head" data-reveal>
        <p class="eyebrow">Occasions</p>
        <h2 class="h2">For every kind of <em>celebration</em></h2>
        <p class="lead">From an intimate shower at home to a reception for three hundred, we scale the table to the moment.</p>
        <Photo
          class="occasions-photo"
          photo={photos.dessertTableBlue}
          ratio="4 / 5"
          shape="arch"
          sizes="(min-width: 960px) 340px, 70vw"
        />
      </div>
      <ol role="list" class="occasions">
        {
          occasions.map((o, i) => (
            <li data-reveal style={`--reveal-delay: ${i * 0.05}s`}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="h3">{o.name}</h3>
                <p>{o.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Process -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow">How booking works</p>
          <h2 class="h2">Simple from <em>enquiry to setup</em></h2>
        </div>
        <p class="lead">We recommend booking 2 to 4 weeks ahead. Last-minute? Ask anyway and we’ll do our best.</p>
      </div>
      <ol role="list" class="steps">
        {
          steps.map((s, i) => (
            <li data-reveal style={`--reveal-delay: ${i * 0.08}s`}>
              <span class="step-num">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Gallery teaser -->
  <section class="section section-tint">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow">Recent tables</p>
          <h2 class="h2">Made fresh, <em>styled on site</em></h2>
        </div>
        <a class="link-arrow" href="/gallery">View the full gallery <span aria-hidden="true">→</span></a>
      </div>
      <ul role="list" class="mosaic">
        {
          teaser.map((p, i) => (
            <li data-reveal style={`--reveal-delay: ${(i % 3) * 0.08}s`}>
              <Photo photo={p} sizes="(min-width: 960px) 400px, 46vw" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Testimonials />

  <!-- Recognition & clients -->
  <section class="section recognition">
    <div class="container recognition-grid">
      <div data-reveal>
        <p class="eyebrow">Recognition</p>
        <h2 class="h3">Award-nominated, and trusted by Adelaide businesses and venues</h2>
        <Awards class="awards-block" />
      </div>
      <div class="names" data-reveal style="--reveal-delay: 0.1s">
        <div>
          <h3 class="names-title">Clients include</h3>
          <ul role="list">{clients.map((c) => <li>{c}</li>)}</ul>
        </div>
        <div>
          <h3 class="names-title">Venues we’ve styled</h3>
          <ul role="list">{venues.map((v) => <li>{v}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* Hero */
  .hero {
    padding-block: clamp(40px, 6vw, 88px) clamp(72px, 9vw, 128px);
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.08fr 1fr;
    align-items: center;
    gap: clamp(40px, 6vw, 96px);
  }

  .hero-copy {
    display: grid;
    gap: 1.6rem;
    justify-items: start;
  }

  .hero-copy .lead {
    max-width: 560px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .trust {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin-top: 0.4rem;
    font-size: 0.88rem;
    color: var(--muted);
  }

  .trust li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .trust li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
  }

  .hero-art {
    position: relative;
    padding: 14px 0 64px 56px;
  }

  .hero-art :global(.hero-main) {
    max-width: 520px;
    margin-left: auto;
  }

  .hero-art :global(.hero-small) {
    position: absolute;
    left: 0;
    bottom: 0;
    width: clamp(150px, 38%, 220px);
    border: 6px solid var(--paper);
    border-radius: calc(var(--radius) + 6px);
    box-shadow: var(--shadow);
  }

  .hero-badge {
    position: absolute;
    right: -8px;
    bottom: 26px;
    display: grid;
    gap: 2px;
    padding: 14px 18px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    line-height: 1.25;
  }

  .badge-kicker {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-ink);
  }

  .badge-title {
    font-family: var(--serif);
    font-size: 1.15rem;
  }

  .badge-detail {
    font-size: 0.78rem;
    color: var(--muted);
  }

  @media (max-width: 859px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-art {
      max-width: 520px;
      padding-left: 40px;
    }

    .hero-badge {
      right: 0;
    }
  }

  /* Section heads */
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.25rem 3rem;
    margin-bottom: clamp(36px, 5vw, 64px);
  }

  .section-head > div {
    display: grid;
    gap: 1rem;
    max-width: 640px;
  }

  .section-head .lead {
    max-width: 440px;
  }

  /* Services */
  .services {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: clamp(16px, 2vw, 24px);
  }

  .service--tall {
    grid-column: span 2;
  }

  .service--wide {
    grid-column: span 3;
  }

  .service a {
    display: grid;
    gap: 1.1rem;
    height: 100%;
    text-decoration: none;
  }

  .service :global(img) {
    transition: transform 0.9s var(--ease);
  }

  .service a:hover :global(img) {
    transform: scale(1.04);
  }

  .service-text {
    display: grid;
    gap: 0.35rem;
  }

  .service-name {
    font-family: var(--serif);
    font-size: var(--step-2);
    line-height: 1.1;
  }

  .service a:hover .service-name {
    color: var(--fig);
  }

  .service-short {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  @media (max-width: 959px) {
    .services {
      grid-template-columns: 1fr 1fr;
    }

    .service--tall,
    .service--wide {
      grid-column: span 1;
    }

    .service--wide:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 599px) {
    .services {
      grid-template-columns: 1fr;
    }
  }

  /* Signature */
  .signature-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(48px, 7vw, 112px);
  }

  .signature-art {
    padding: 14px 0 0 14px;
  }

  .signature-copy {
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }

  .specs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    width: 100%;
    margin: 0.4rem 0 0.6rem;
    border-top: 1px solid var(--line);
  }

  .specs div {
    padding: 1rem 1rem 1rem 0;
    border-bottom: 1px solid var(--line);
  }

  .specs dt {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .specs dd {
    margin: 0.2rem 0 0;
    font-family: var(--serif);
    font-size: 1.25rem;
    line-height: 1.25;
  }

  @media (max-width: 859px) {
    .signature-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Occasions */
  .occasions-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(40px, 7vw, 112px);
    align-items: start;
  }

  .occasions-head {
    position: sticky;
    top: 112px;
    display: grid;
    gap: 1.2rem;
    justify-items: start;
  }

  .occasions-head :global(.occasions-photo) {
    width: min(100%, 340px);
    margin-top: 1rem;
  }

  .occasions li {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 1rem;
    padding-block: clamp(22px, 3vw, 34px);
    border-bottom: 1px solid var(--line);
  }

  .occasions li:first-child {
    border-top: 1px solid var(--line);
  }

  .occasions .num {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--fig);
    padding-top: 0.55rem;
  }

  .occasions h3 {
    margin-bottom: 0.4rem;
  }

  .occasions p {
    color: var(--ink-soft);
  }

  @media (max-width: 859px) {
    .occasions-grid {
      grid-template-columns: 1fr;
    }

    .occasions-head {
      position: static;
    }

    .occasions-head :global(.occasions-photo) {
      display: none;
    }
  }

  /* Steps */
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(20px, 3vw, 40px);
    counter-reset: step;
  }

  .steps li {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--ink);
  }

  .step-num {
    font-family: var(--serif);
    font-size: 3.2rem;
    line-height: 1;
    color: var(--fig);
  }

  .steps h3 {
    font-size: 1.45rem;
  }

  .steps p {
    color: var(--ink-soft);
    font-size: 0.97rem;
  }

  @media (max-width: 959px) {
    .steps {
      grid-template-columns: 1fr 1fr;
      row-gap: 40px;
    }
  }

  @media (max-width: 539px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }

  /* Mosaic */
  .mosaic {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: clamp(140px, 17vw, 210px);
    gap: clamp(10px, 1.4vw, 18px);
  }

  .mosaic li:nth-child(1) {
    grid-row: span 2;
  }

  .mosaic li:nth-child(2) {
    grid-row: span 2;
  }

  .mosaic li:nth-child(3) {
    grid-row: span 3;
  }

  .mosaic li:nth-child(4) {
    grid-row: span 2;
  }

  .mosaic li:nth-child(5) {
    grid-row: span 2;
  }

  .mosaic li:nth-child(6) {
    grid-row: span 1;
  }

  .mosaic li :global(.photo),
  .mosaic li :global(.clip) {
    height: 100%;
  }

  @media (max-width: 599px) {
    .mosaic {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 150px;
    }

    .mosaic li:nth-child(n) {
      grid-row: span 2;
    }
  }

  /* Recognition */
  .recognition {
    border-top: 1px solid var(--line);
  }

  .recognition-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 96px);
  }

  .recognition-grid > div:first-child {
    display: grid;
    gap: 1.2rem;
    align-content: start;
  }

  .recognition-grid :global(.awards-block) {
    margin-top: 0.8rem;
    flex-direction: column;
  }

  .names {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  .names-title {
    margin-bottom: 1rem;
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .names ul {
    display: grid;
    gap: 0.5rem;
    font-family: var(--serif);
    font-size: 1.2rem;
    line-height: 1.3;
  }

  @media (max-width: 859px) {
    .recognition-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 479px) {
    .names {
      grid-template-columns: 1fr;
    }
  }
</style>
